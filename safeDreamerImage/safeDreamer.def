# Puts together the final SafeDreamer image on the cluster, from two public images:
# our open-source one (built from the Dockerfile by GitHub) and NVIDIA's, which supplies CUDA.
#
# It only copies files. There is no install step, because installing needs admin rights
# inside the image and the cluster does not allow that.
#
# Built by build_image.sh. To run a command inside the result, with the node's GPU:
#   apptainer exec --nv ~/images/safeDreamer.sif python3 some_script.py

# Stage 1: NVIDIA's image. Used only as the source of CUDA 11.8 and cuDNN 8.
Bootstrap: docker
From: nvidia/cuda:11.8.0-cudnn8-devel-ubuntu20.04
Stage: cuda

# Stage 2: our image, pinned to the commit that built it, with CUDA copied in.
Bootstrap: docker
From: ghcr.io/sachin2911/safedreamer-base:49c775ea1061a25f3ec4e65c2924ca0f8da46419
Stage: final

%files from cuda
    /usr/local/cuda-11.8 /usr/local/cuda-11.8
    /usr/lib/x86_64-linux-gnu/libcudnn* /usr/lib/x86_64-linux-gnu/

%environment
    # Where JAX finds the CUDA programs (bin), libraries (lib64), and its compiler files.
    export PATH=/usr/local/cuda-11.8/bin:$PATH
    # /usr/lib/x86_64-linux-gnu comes first so the image's own graphics libraries are used.
    # `--nv` also brings in the node's copies, which are built for a newer Ubuntu and fail here.
    export LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:/usr/local/cuda-11.8/lib64:/usr/local/cuda-11.8/extras/CUPTI/lib64:${LD_LIBRARY_PATH:-}
    export XLA_FLAGS=--xla_gpu_cuda_data_dir=/usr/local/cuda-11.8

%labels
    base.image ghcr.io/sachin2911/safedreamer-base:49c775ea1061a25f3ec4e65c2924ca0f8da46419
    cuda.image nvidia/cuda:11.8.0-cudnn8-devel-ubuntu20.04
